# OpenAI (required for the agent). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override. Leave empty to use the OpenAI Agents SDK default model.
OPENAI_MODEL=

# Copernicus Data Space Ecosystem OAuth client (optional but recommended).
# Enables the ESA EVE CDSE MCP quicklooks and CDSE Sentinel-2 L1C/L2A analysis imagery.
# Without it, analysis imagery falls back to public Element84 Earth Search (L2A only).
# Create at https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings (OAuth clients).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Paths (relative to the project root)
EO_DATA_DIR=./data
UPSTREAM_REGISTRY_DIR=./third_party/mcp-tool-registry

# Inference: auto | cuda | cpu
TORCH_DEVICE=auto
# fp16 autocast for Prithvi on CUDA (reduces VRAM on 6 GB GPUs)
PRITHVI_HALF_PRECISION=false

# Spectral index thresholds (literature defaults, every result reports the value that was used)
# NDVI: a pixel is vegetation when NDVI >= this value (0.5 as in the forest loss notebook)
NDVI_THRESHOLD=0.5
# NBR: a pixel is burned when dNBR (NBR before - NBR after) >= this value. USGS: 0.1 low severity, 0.27 moderate-low
NBR_BURNED_DNBR=0.1
# AWEI: water where AWEI > threshold. The paper uses 0, the default -0.15 also finds dark water in older Sentinel-2 scenes (see README). Variant nsh (default) or sh (shadow-prone mountain terrain)
AWEI_THRESHOLD=-0.15
AWEI_VARIANT=nsh
# NDSI: snow where NDSI >= threshold and the green reflectance is at least NDSI_MIN_GREEN
NDSI_THRESHOLD=0.4
NDSI_MIN_GREEN=0.3
# BSI: bare soil where BSI >= threshold and NDVI < BSI_MAX_NDVI. BSI alone misjudges both dry scrub and pale desert (see README)
BSI_THRESHOLD=0.0
BSI_MAX_NDVI=0.2

# Limits
MAX_AOI_KM=20
MCP_TIMEOUT_S=900
# Hard cap of before/after pairs shown per answer (1 to 10)
MAX_PAIRS_PER_ANSWER=10
GDACS_MAX_EVENTS=50
